{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ESNext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["snippets"],
  // React Native screens are checked in tsconfig.snippets-rn.json
  "exclude": ["snippets/*/src/**/*.tsx"]
}
